    def load_profiles(self):
        if not os.path.exists(CHROME_CONFIG_DIR):
            self.show_error("Google Chrome does not appear to be installed (config directory is missing).")
            return
            
        profiles = []
        local_state_path = os.path.join(CHROME_CONFIG_DIR, "Local State")
        
        info_cache = {}
        if os.path.exists(local_state_path):
            try:
                with open(local_state_path, "r") as f:
                    state_data = json.load(f)
                    info_cache = state_data.get("profile", {}).get("info_cache", {})
            except Exception as e:
                print(f"Error reading Local State: {e}")
                
        if info_cache:
            for p_dir, p_info in info_cache.items():
                if os.path.exists(os.path.join(CHROME_CONFIG_DIR, p_dir)):
                    name = p_info.get("name")
                    email = p_info.get("user_name")
                    
                    if name and email:
                        display_name = f"{name} ({email})"
                    elif name:
                        display_name = name
                    elif email:
                        display_name = email
                    else:
                        display_name = p_dir
                        
                    profiles.append((p_dir, display_name))
        
        if not profiles:
            default_pref = os.path.join(CHROME_CONFIG_DIR, "Default", "Preferences")
            if os.path.exists(default_pref):
                profiles.append(("Default", "Default (Primary)"))
                
            for folder in glob.glob(os.path.join(CHROME_CONFIG_DIR, "Profile *")):
                profile_dir = os.path.basename(folder)
                pref_path = os.path.join(folder, "Preferences")
                profile_name = profile_dir
                if os.path.exists(pref_path):
                    try:
                        with open(pref_path, "r") as f:
                            data = json.load(f)
                            name_val = data.get("profile", {}).get("name")
                            if name_val and name_val != "Your Chrome":
                                profile_name = f"{profile_dir} ({name_val})"
                    except Exception:
                        pass
                profiles.append((profile_dir, profile_name))
                
        profiles.sort(key=lambda x: (0 if x[0] == "Default" else 1, x[1].lower()))
        
        for p_dir, p_name in profiles:
            self.profile_combo.append(p_dir, p_name)
            
        if profiles:
            self.profile_combo.set_active(0)

    def on_profile_changed(self, combo):
        active_id = combo.get_active_id()
        if active_id:
            self.selected_profile = active_id
            active_text = combo.get_active_text()
            
            match = re.match(r'^([^\(]+)', active_text)
            if match:
                profile_nick = match.group(1).strip()
            else:
                profile_nick = active_text
                
            if profile_nick.lower() == "default":
                profile_nick = "Primary"
                
            self.name_entry.set_text(f"Chrome - {profile_nick}")
            
            badge_letter = profile_nick[0].upper() if profile_nick else "C"
            self.badge_entry.set_text(badge_letter)

    def on_preset_color_clicked(self, widget, color_hex):
        if getattr(self, "is_updating_color", False):
            return
        self.is_updating_color = True
        self.selected_color = color_hex
        self.hex_entry.set_text(color_hex)
        self.update_color_button(color_hex)
        self.update_preview()
        self.is_updating_color = False

    def on_custom_color_set(self, widget):
        if getattr(self, "is_updating_color", False):
            return
        self.is_updating_color = True
        rgba = widget.get_rgba()
        r = int(rgba.red * 255)
        g = int(rgba.green * 255)
        b = int(rgba.blue * 255)
        color_hex = f"#{r:02X}{g:02X}{b:02X}"
        self.selected_color = color_hex
        self.hex_entry.set_text(color_hex)
        self.update_preview()
        self.is_updating_color = False

    def on_hex_entry_changed(self, entry):
        if getattr(self, "is_updating_color", False):
            return
        color_hex = entry.get_text().strip()
        if re.match(r"^#[0-9a-fA-F]{6}$", color_hex):
            self.is_updating_color = True
            self.selected_color = color_hex
            self.update_color_button(color_hex)
            self.update_preview()
            self.is_updating_color = False
        elif re.match(r"^#[0-9a-fA-F]{3}$", color_hex):
            r, g, b = color_hex[1], color_hex[2], color_hex[3]
            color_hex = f"#{r}{r}{g}{g}{b}{b}"
            self.is_updating_color = True
            self.selected_color = color_hex
            self.update_color_button(color_hex)
            self.update_preview()
            self.is_updating_color = False

    def update_color_button(self, color_hex):
        try:
            r = int(color_hex[1:3], 16) / 255.0
            g = int(color_hex[3:5], 16) / 255.0
            b = int(color_hex[5:7], 16) / 255.0
            rgba = Gdk.RGBA(r, g, b, 1.0)
            self.custom_color_btn.set_rgba(rgba)
        except Exception as e:
            print(f"Error updating color button: {e}")

    def update_preview(self):
        text = self.badge_entry.get_text()
        color = self.selected_color
        
        preview_path = "/tmp/chrome_badge_preview_tmp.png"
        try:
            generate_badged_icon(color, text, preview_path)
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(preview_path, 96, 96, True)
            self.preview_img.set_from_pixbuf(pixbuf)
        except Exception as e:
            print(f"Error drawing preview: {e}")

    def load_existing_shortcuts(self):
        for child in self.listbox.get_children():
            self.listbox.remove(child)
            
        entries = glob.glob(os.path.join(DESKTOP_DIR, "chrome-profile-*.desktop"))
        for entry_path in entries:
            # Skip the decorator tool itself
            if "chrome-profile-decorator.desktop" in entry_path or "chrome-profile-badger.desktop" in entry_path:
                continue
                
            try:
                name = ""
                profile = ""
                icon_path = ""
                with open(entry_path, "r") as f:
                    for line in f:
                        if line.startswith("Name="):
                            name = line.strip().split("Name=")[1]
                        elif line.startswith("Icon="):
                            icon_path = line.strip().split("Icon=")[1]
                        elif line.startswith("Exec="):
                            exec_line = line.strip()
                            match_p = re.search(r'--profile\s+"([^"]+)"', exec_line)
                            if not match_p:
                                match_p = re.search(r'--profile\s+([^\s]+)', exec_line)
                            if match_p:
                                profile = match_p.group(1)
                                
                if not name:
                    name = os.path.basename(entry_path)
                    
                self.add_shortcut_row(name, profile, icon_path, entry_path)
            except Exception as e:
                print(f"Error reading desktop file {entry_path}: {e}")
                
        self.listbox.show_all()

    def add_shortcut_row(self, name, profile, icon_path, desktop_path):
        row = Gtk.ListBoxRow()
        row_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        row_box.set_property("margin", 5)
        row.add(row_box)
        
        img = Gtk.Image()
        if os.path.exists(icon_path):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(icon_path, 32, 32, True)
                img.set_from_pixbuf(pixbuf)
            except Exception:
                img.set_from_icon_name("google-chrome", Gtk.IconSize.LARGE_TOOLBAR)
        else:
            img.set_from_icon_name("google-chrome", Gtk.IconSize.LARGE_TOOLBAR)
            
        row_box.pack_start(img, False, False, 0)
        
        details_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        details_label = Gtk.Label(xalign=0.0)
        details_label.set_markup(f"<b>{name}</b>")
        info_label = Gtk.Label(xalign=0.0)
        info_label.set_markup(f"<span size='small' foreground='#777'>Profile: {profile}</span>")
        
        details_vbox.pack_start(details_label, False, False, 0)
        details_vbox.pack_start(info_label, False, False, 0)
        row_box.pack_start(details_vbox, True, True, 0)
        
        del_btn = Gtk.Button()
        del_btn.set_image(Gtk.Image.new_from_icon_name("edit-delete", Gtk.IconSize.BUTTON))
        del_btn.set_relief(Gtk.ReliefStyle.NONE)
        del_btn.connect("clicked", self.on_delete_shortcut_clicked, desktop_path, icon_path)
        row_box.pack_start(del_btn, False, False, 0)
        
        self.listbox.add(row)

    def on_delete_shortcut_clicked(self, widget, desktop_path, icon_path):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.YES_NO,
            text="Do you want to delete this shortcut?"
        )
        dialog.format_secondary_text(f"This will permanently delete the shortcut '{os.path.basename(desktop_path)}' from your launcher menus.")
        
        response = dialog.run()
        if response == Gtk.ResponseType.YES:
            try:
                if os.path.exists(desktop_path):
                    os.remove(desktop_path)
                if os.path.exists(icon_path):
                    os.remove(icon_path)
                self.load_existing_shortcuts()
            except Exception as e:
                self.show_error(f"Could not delete shortcut files: {e}")
                
        dialog.destroy()

    def on_create_shortcut_clicked(self, widget):
        display_name = self.name_entry.get_text().strip()
        badge_text = self.badge_entry.get_text().strip()
        profile_folder = self.selected_profile
        color = self.selected_color
        
        if not display_name:
            self.show_error("Please enter a name for the shortcut.")
            return
            
        class_name = "chrome-profile-" + re.sub(r'[^a-zA-Z0-9]', '-', display_name.lower())
        
        icon_filename = f"{class_name}.png"
        icon_path = os.path.join(ICONS_DIR, icon_filename)
        desktop_filename = f"{class_name}.desktop"
        desktop_path = os.path.join(DESKTOP_DIR, desktop_filename)
        
        try:
            generate_badged_icon(color, badge_text, icon_path)
            
            script_path = os.path.abspath(__file__)
            desktop_content = f"""[Desktop Entry]
Version=1.0
Type=Application
Name={display_name}
Comment=Google Chrome profile: {profile_folder}
Exec=python3 {script_path} --launcher --profile "{profile_folder}" --class-name "{class_name}" --color "{color}" --badge "{badge_text}"
Icon={icon_path}
StartupWMClass={class_name}
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
"""
            with open(desktop_path, "w") as f:
                f.write(desktop_content)
                
            os.chmod(desktop_path, 0o755)
            self.load_existing_shortcuts()
            
            dialog = Gtk.MessageDialog(
                transient_for=self,
                flags=0,
                message_type=Gtk.MessageType.INFO,
                buttons=Gtk.ButtonsType.OK,
                text="Shortcut created successfully!"
            )
            dialog.format_secondary_text(
                f"The shortcut '{display_name}' has been added to your applications menu.\n\n"
                "Search for it in your system start menu (under 'Internet') and add/pin it to your panel (taskbar)."
            )
            dialog.run()
            dialog.destroy()
            
        except Exception as e:
            self.show_error(f"Could not create shortcut: {e}")

    def show_error(self, message):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            flags=0,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE,
            text="An error occurred"
        )
        dialog.format_secondary_text(message)
        dialog.run()
        dialog.destroy()

# --- MAIN INVOCATION ENTRY ---

def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--launcher":
        profile_dir = "Default"
        class_name = "chrome-profile-default"
        color_hex = "#3B82F6"
        badge_text = ""
        
        for i in range(len(sys.argv)):
            if sys.argv[i] == "--profile" and i+1 < len(sys.argv):
                profile_dir = sys.argv[i+1]
            elif sys.argv[i] in ("--class", "--class-name") and i+1 < len(sys.argv):
                class_name = sys.argv[i+1]
            elif sys.argv[i] == "--color" and i+1 < len(sys.argv):
                color_hex = sys.argv[i+1]
            elif sys.argv[i] == "--badge" and i+1 < len(sys.argv):
                badge_text = sys.argv[i+1]
                
        run_launcher(profile_dir, class_name, color_hex, badge_text)
    else:
        Gtk.init(None)
        app = ChromeProfileBadgerApp()
        app.connect("destroy", Gtk.main_quit)
        app.show_all()
        Gtk.main()

if __name__ == "__main__":
    main()
