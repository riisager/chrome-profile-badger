def generate_badged_icon(badge_color_hex, badge_text, output_path):
    icon_path = "/opt/google/chrome/product_logo_256.png"
    if not os.path.exists(icon_path):
        icon_path = "/usr/share/icons/hicolor/256x256/apps/google-chrome.png"
        
    try:
        img = Image.open(icon_path).convert("RGBA")
    except Exception:
        # Fallback empty canvas if Chrome logo is missing
        img = Image.new("RGBA", (256, 256), (255, 255, 255, 0))
        
    w, h = img.size
    draw = ImageDraw.Draw(img)
    
    # Parse color
    color_hex = badge_color_hex.lstrip('#')
    r = int(color_hex[0:2], 16)
    g = int(color_hex[2:4], 16)
    b = int(color_hex[4:6], 16)
    badge_rgb = (r, g, b)
    
    if badge_text:
        # Determine initial font size and padding dynamically based on text length
        text_len = len(badge_text)
        if text_len <= 2:
            font_size = 84
            padding_x = 36
        elif text_len <= 4:
            font_size = 70
            padding_x = 30
        elif text_len <= 7:
            font_size = 58
            padding_x = 24
        else:
            font_size = 46
            padding_x = 18

        # Load font and adjust size dynamically if it exceeds the icon width
        margin = 4
        max_allowed_width = w - 2 * margin  # 248
        font = None
        
        for attempt in range(15):
            try:
                font_paths = [
                    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
                    "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
                    "/usr/share/fonts/truetype/freefont/FreeSansBold.ttf"
                ]
                for fp in font_paths:
                    if os.path.exists(fp):
                        font = ImageFont.truetype(fp, font_size)
                        break
            except Exception:
                font = None

            if font:
                if hasattr(font, "getbbox"):
                    bbox = font.getbbox(badge_text)
                    tw = bbox[2] - bbox[0]
                    th = bbox[3] - bbox[1]
                else:
                    tw, th = font.getsize(badge_text)
            else:
                tw, th = len(badge_text) * (font_size // 2), font_size - 10

            capsule_height = 144
            capsule_width = tw + 2 * padding_x
            
            # If the capsule fits within icon width, we stop
            if max(capsule_height, capsule_width) <= max_allowed_width or font_size <= 16:
                capsule_width = max(capsule_height, capsule_width)
                break
                
            font_size -= 4
            padding_x = max(8, padding_x - 2)
            
        # Position at the bottom-right of the Chrome icon
        bx = w - capsule_width - margin
        by = h - capsule_height - margin
        
        # Draw white outer capsule (border)
        draw.rounded_rectangle([bx, by, bx + capsule_width, by + capsule_height], radius=capsule_height//2, fill=(255, 255, 255, 255))
        
        # Draw inner colored capsule
        border_width = 8
        ibx = bx + border_width
        iby = by + border_width
        iw = capsule_width - 2 * border_width
        ih = capsule_height - 2 * border_width
        draw.rounded_rectangle([ibx, iby, ibx + iw, iby + ih], radius=ih//2, fill=badge_rgb + (255,))
        
        # Draw centered text
        if font:
            tx = ibx + (iw - tw) // 2
            # Slight vertical offset adjustment based on font size
            vertical_offset = 8 if font_size >= 70 else 5
            ty = iby + (ih - th) // 2 - vertical_offset
            draw.text((tx, ty), badge_text, fill=(255, 255, 255, 255), font=font)
        else:
            draw.text((ibx + 10, iby + 10), badge_text, fill=(255, 255, 255, 255))
            
    img.save(output_path, "PNG")

# --- LAUNCHER MODE ---

def get_client_windows(disp):
    try:
        root = disp.screen().root
        net_client_list = disp.intern_atom('_NET_CLIENT_LIST')
        prop = root.get_full_property(net_client_list, X.AnyPropertyType)
        if prop:
            return set(prop.value)
    except Exception:
        pass
    return set()

def get_window_class(disp, win_id):
    try:
        win = disp.create_resource_object('window', win_id)
        wm_class_atom = disp.intern_atom('WM_CLASS')
        prop = win.get_full_property(wm_class_atom, X.AnyPropertyType)
        if prop and prop.value:
            val = prop.value
            if isinstance(val, bytes):
                val = val.decode('utf-8', errors='ignore')
            parts = [p for p in val.split('\0') if p]
            return parts
    except Exception:
        pass
    return []

def apply_icon_and_class_to_window(win_id, class_name, icon_path):
    try:
        disp = display.Display()
        win = disp.create_resource_object('window', win_id)
        
        # 1. Update WM_CLASS
        wm_class_atom = disp.intern_atom('WM_CLASS')
        string_atom = disp.intern_atom('STRING')
        wm_class_str = f"{class_name}\0{class_name.capitalize()}\0"
        win.change_property(wm_class_atom, string_atom, 8, wm_class_str.encode('utf-8'))
        
        # 2. Update _NET_WM_ICON (Resize to 128x128 to stay within X11 request length limits)
        if os.path.exists(icon_path):
            try:
                resampling = Image.Resampling.LANCZOS
            except AttributeError:
                resampling = Image.LANCZOS
            img = Image.open(icon_path).resize((128, 128), resampling).convert("RGBA")
            w, h = img.size
            data = [w, h]
            for y in range(h):
                for x in range(w):
                    r, g, b, a = img.getpixel((x, y))
                    argb = (a << 24) | (r << 16) | (g << 8) | b
                    data.append(argb)
            
            net_wm_icon = disp.intern_atom('_NET_WM_ICON')
            cardinal = disp.intern_atom('CARDINAL')
            win.change_property(net_wm_icon, cardinal, 32, data, X.PropModeReplace)
            
        disp.flush()
        return True
    except Exception as e:
        print(f"Error applying window updates: {e}")
        return False

def run_launcher(profile_dir, class_name, color_hex, badge_text):
    ensure_directories()
    icon_name = f"chrome-profile-{class_name}"
    icon_path = os.path.join(ICONS_DIR, f"{icon_name}.png")
    
    # Double-check that the icon exists, if not generate it
    if not os.path.exists(icon_path):
        generate_badged_icon(color_hex, badge_text, icon_path)
        
    try:
        disp = display.Display()
    except Exception:
        # Fallback if no X server connection (just run Chrome)
        subprocess.Popen(["google-chrome", f"--profile-directory={profile_dir}"])
        return

    # Helper to get the active window
    def get_active_win(d):
        try:
            root = d.screen().root
            net_active = d.intern_atom('_NET_ACTIVE_WINDOW')
            prop = root.get_full_property(net_active, X.AnyPropertyType)
            if prop and prop.value:
                return prop.value[0]
        except Exception:
            pass
        return None

    # Check state before launching
    old_windows = get_client_windows(disp)
    old_active = get_active_win(disp)
    
    # Launch Chrome
    subprocess.Popen(["google-chrome", f"--profile-directory={profile_dir}"])
    
    # Poll for the window (either new window or newly focused window)
    target_win_id = None
    for _ in range(50):  # Poll up to 5 seconds
        time.sleep(0.1)
        # We must recreate the display to refresh the window list property cache in python-xlib
        loop_disp = display.Display()
        current_windows = get_client_windows(loop_disp)
        active_win = get_active_win(loop_disp)
        
        # Scenario A: A new window appeared
        new_candidates = current_windows - old_windows
        for win_id in new_candidates:
            classes = get_window_class(loop_disp, win_id)
            if "google-chrome" in classes or "Google-chrome" in classes:
                target_win_id = win_id
                break
                
        # Scenario B: No new window, but an existing Chrome window got focused
        if not target_win_id and active_win and active_win != old_active:
            classes = get_window_class(loop_disp, active_win)
            if "google-chrome" in classes or "Google-chrome" in classes:
                target_win_id = active_win
                break
                
        if target_win_id:
            break
            
    if target_win_id:
        time.sleep(0.15)  # Tiny pause to let the window draw/focus fully
        apply_icon_and_class_to_window(target_win_id, class_name, icon_path)

